# Multi-Stage Production Dockerfile for CFI Frontend SPA
# Stage 1: Build production bundle
FROM node:22-alpine@sha256:5b05da3f938f1c604b24c633646d48805a6667f378cb4908438616f3cc48a0bf AS builder

WORKDIR /app

# Copy package manifests first for optimal layer caching
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --prefer-offline --no-audit

# Copy source code and configuration files
COPY frontend/ ./

# Build production distribution
RUN npm run build

# Stage 2: Minimalist, hardened Nginx runtime
FROM nginx:alpine@sha256:713fc2ebfd92e8217db451477182ee91944b123d2b1ee9fd5a8c6e91ca6c3a11 AS runtime

RUN apk update && apk add --no-cache \
    brotli-libs=1.2.1-r0 \
    curl=8.23.0-r0 \
    libcurl=8.23.0-r0 \
    libexpat=2.10.0-r0 \
    libxslt=1.1.43-r4 \
    zlib=1.4-r0 \
    apk-tools=3.0.9-r0 \
    libapk=3.0.9-r0

# Remove default Nginx welcome site
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy custom SPA Nginx configuration
COPY docker/nginx/frontend-nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
