<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:pain.001.001.08"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:pain.001.001.08"
           elementFormDefault="qualified">
  <xs:element name="Document" type="Document"/>
  <xs:complexType name="Document">
    <xs:sequence>
      <xs:element name="CstmrCdtTrfInitn" type="CstmrCdtTrfInitn"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CstmrCdtTrfInitn">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="GrpHdr" type="GrpHdr"/>
      <xs:element name="PmtInf" type="PaymentInstruction"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="GrpHdr">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="MsgId" type="xs:string"/>
      <xs:element name="CreDtTm" type="xs:string"/>
      <xs:element name="NbOfTxs" type="xs:string"/>
      <xs:element name="CtrlSum" type="xs:decimal"/>
      <xs:element name="InitgPty" type="PartyIdentification"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="PaymentInstruction">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="PmtInfId" type="xs:string"/>
      <xs:element name="PmtMtd" type="xs:string"/>
      <xs:element name="BtchBookg" type="xs:boolean"/>
      <xs:element name="NbOfTxs" type="xs:string"/>
      <xs:element name="CtrlSum" type="xs:decimal"/>
      <xs:element name="PmtTpInf" type="PaymentTypeInformation"/>
      <xs:element name="ReqdExctnDt" type="DateChoice"/>
      <xs:element name="Dbtr" type="PartyIdentification"/>
      <xs:element name="DbtrAcct" type="AccountIdentification"/>
      <xs:element name="DbtrAgt" type="BranchAndFinancialInstitutionIdentification"/>
      <xs:element name="ChrgBr" type="xs:string"/>
      <xs:element name="CdtTrfTxInf" type="CreditTransferTransactionInformation"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="PaymentTypeInformation">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="InstrPrty" type="xs:string"/>
      <xs:element name="SvcLvl" type="ServiceLevelChoice"/>
      <xs:element name="LclInstrm" type="LocalInstrumentChoice"/>
      <xs:element name="CtgyPurp" type="CategoryPurposeChoice"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="ServiceLevelChoice">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Cd" type="xs:string"/>
      <xs:element name="Prtry" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="LocalInstrumentChoice">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Cd" type="xs:string"/>
      <xs:element name="Prtry" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="CategoryPurposeChoice">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Cd" type="xs:string"/>
      <xs:element name="Prtry" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="DateChoice">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Dt" type="xs:string"/>
      <xs:element name="DtTm" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="CreditTransferTransactionInformation">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="PmtId" type="PaymentIdentification"/>
      <xs:element name="PmtTpInf" type="PaymentTypeInformation"/>
      <xs:element name="Amt" type="AmountChoice"/>
      <xs:element name="ChrgBr" type="xs:string"/>
      <xs:element name="Dbtr" type="PartyIdentification"/>
      <xs:element name="DbtrAcct" type="AccountIdentification"/>
      <xs:element name="DbtrAgt" type="BranchAndFinancialInstitutionIdentification"/>
      <xs:element name="Cdtr" type="PartyIdentification"/>
      <xs:element name="CdtrAcct" type="AccountIdentification"/>
      <xs:element name="CdtrAgt" type="BranchAndFinancialInstitutionIdentification"/>
      <xs:element name="InstrForCdtrAgt" type="xs:anyType"/>
      <xs:element name="Purp" type="xs:anyType"/>
      <xs:element name="RgltryRptg" type="xs:anyType"/>
      <xs:element name="RmtInf" type="RemittanceInformation"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="PaymentIdentification">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="InstrId" type="xs:string"/>
      <xs:element name="EndToEndId" type="xs:string"/>
      <xs:element name="TxId" type="xs:string"/>
      <xs:element name="UETR" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="AmountChoice">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="InstdAmt" type="ActiveOrHistoricCurrencyAndAmount"/>
      <xs:element name="EqvtAmt" type="EquivalentAmount"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="ActiveOrHistoricCurrencyAndAmount">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="Ccy" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="EquivalentAmount">
    <xs:sequence>
      <xs:element name="Amt" type="ActiveOrHistoricCurrencyAndAmount"/>
      <xs:element name="CcyOfTrf" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PartyIdentification">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Nm" type="xs:string"/>
      <xs:element name="PstlAdr" type="PostalAddress"/>
      <xs:element name="Id" type="xs:anyType"/>
      <xs:element name="CtryOfRes" type="xs:string"/>
      <xs:element name="CtctDtls" type="xs:anyType"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="PostalAddress">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="AdrTp" type="xs:anyType"/>
      <xs:element name="Dept" type="xs:string"/>
      <xs:element name="SubDept" type="xs:string"/>
      <xs:element name="StrtNm" type="xs:string"/>
      <xs:element name="BldgNb" type="xs:string"/>
      <xs:element name="PstCd" type="xs:string"/>
      <xs:element name="TwnNm" type="xs:string"/>
      <xs:element name="CtrySubDvsn" type="xs:string"/>
      <xs:element name="Ctry" type="xs:string"/>
      <xs:element name="AdrLine" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="AccountIdentification">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Id" type="AccountChoice"/>
      <xs:element name="Tp" type="xs:anyType"/>
      <xs:element name="Ccy" type="xs:string"/>
      <xs:element name="Nm" type="xs:string"/>
      <xs:element name="Svcr" type="BranchAndFinancialInstitutionIdentification"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="AccountChoice">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="IBAN" type="xs:string"/>
      <xs:element name="Othr" type="OtherAccount"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="OtherAccount">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Id" type="xs:string"/>
      <xs:element name="SchmeNm" type="xs:anyType"/>
      <xs:element name="Issr" type="xs:string"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="BranchAndFinancialInstitutionIdentification">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="FinInstnId" type="FinancialInstitutionIdentification"/>
      <xs:element name="BrnchId" type="xs:anyType"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="FinancialInstitutionIdentification">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="BICFI" type="xs:string"/>
      <xs:element name="ClrSysMmbId" type="xs:anyType"/>
      <xs:element name="Nm" type="xs:string"/>
      <xs:element name="PstlAdr" type="PostalAddress"/>
      <xs:element name="Othr" type="xs:anyType"/>
    </xs:choice>
  </xs:complexType>
  <xs:complexType name="RemittanceInformation">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="Ustrd" type="xs:string"/>
      <xs:element name="Strd" type="xs:anyType"/>
    </xs:choice>
  </xs:complexType>
</xs:schema>
