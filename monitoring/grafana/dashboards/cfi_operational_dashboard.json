{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Active Consortium Bank Nodes",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "cfi_active_bank_nodes",
          "legendFormat": "Active Nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "title": "Real-Time Inference Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cfi_inference_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cfi_inference_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cfi_inference_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency (ms)",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Transaction Scoring Volume Rate",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cfi_inference_latency_ms_count[5m])) by (decision)",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Differential Privacy Epsilon Consumed",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(cfi_dp_epsilon_consumed_total)",
          "legendFormat": "Total Epsilon",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 6.4 },
              { "color": "red", "value": 7.5 }
            ]
          }
        }
      }
    },
    {
      "title": "Active Champion Model AUC Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "cfi_champion_model_auc",
          "legendFormat": "Holdout AUC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0.5,
          "max": 1.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      }
    },
    {
      "title": "Gradient Rejection Rate & Anomaly Reasons",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(cfi_gradient_rejections_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cfi", "operational", "prometheus"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "CFI Operational Intelligence Dashboard",
  "uid": "cfi_operational_dashboard"
}
