{
  "name": "fraud-intelligence-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:e2e": "vitest run src/e2e",
    "test:integration": "vitest run src/integration src/pages",
    "test:unit": "vitest run src/components src/utils src/services src/api",
    "test:responsive": "vite build && playwright test e2e-responsive",
    "test:e2e:workflows": "playwright test e2e-workflows --project=desktop-1440-chromium",
    "test:visual": "vite build && playwright test e2e-visual --project=desktop-1440-chromium",
    "test:visual:update": "vite build && playwright test e2e-visual --project=desktop-1440-chromium --update-snapshots",
    "test:a11y": "vite build && playwright test e2e-a11y --project=desktop-1440-chromium",
    "test:mutation": "vitest run src/utils/__tests__/mutationHardening.test.ts src/utils/__tests__/formatters.test.ts",
    "test:mutation:stryker": "npx stryker run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.67.0",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.21.9",
    "@types/three": "^0.185.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@xyflow/react": "^12.11.5",
    "axios": "^1.7.9",
    "cytoscape": "^3.34.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.15.1",
    "three": "^0.185.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0"
  }
}
