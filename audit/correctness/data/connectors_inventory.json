      "direction": "BIDIRECTIONAL",
      "supported_formats": [
        "Mambu v2 Webhook JSON",
        "deposit-transaction.created",
        "client.created",
        "account.hold"
      ],
      "authentication": "API Key / HMAC-SHA256 Webhook Signatures",
      "tenant_scoping": "Explicit tenant_id parameter bound to bank node",
      "runtime_status": "ACTIVE_RUNTIME"
    },
    {
      "connector_id": "thought_machine",
