{
  "audit_capability": "data_connectors_and_ingestion",
  "audit_scope": "production_runtime_connectors",
  "connectors": [
    {
      "connector_id": "iso20022",
      "class_name": "ISO20022MessagingConnector",
      "module": "app.infrastructure.connectors.iso20022_connector",
      "protocol": "XML/SWIFT MT Text over HTTP/mTLS",
      "direction": "INBOUND",
      "supported_formats": [
        "pacs.008.001.08",
        "pain.001.001.08",
        "camt.053.001.08",
        "pacs.002.001.10",
        "pacs.003.001.08",
        "SWIFT_MT103"
      ],
      "authentication": "mTLS / API Key / XSD Schema Validation",
      "tenant_scoping": "ISO20022 / Debtor BIC country / Bank partition",
      "runtime_status": "ACTIVE_RUNTIME"
    },
    {
      "connector_id": "kafka_streaming",
      "class_name": "KafkaStreamingConnector",
      "module": "app.infrastructure.connectors.kafka_streaming_connector",
      "protocol": "Apache Kafka / CloudEvents 1.0 JSON over SASL_SSL",
      "direction": "BIDIRECTIONAL",
      "supported_formats": [
        "CNCF CloudEvents 1.0",
        "org.cfi.finint.transaction.v1",
        "org.cfi.finint.alert.v1",
        "org.cfi.finint.recall.v1",
        "org.cfi.finint.deadletter.v1"
      ],
      "authentication": "SCRAM-SHA-256 / SASL_SSL / HMAC-SHA256 event signatures",
