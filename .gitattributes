# Exclude Playwright visual regression snapshots from Git LFS so they are committed as native binary assets
frontend/e2e-visual/snapshots/** -filter -diff -merge
# Exclude test fixtures from Git LFS so they are committed as native binary assets
backend/tests/fixtures/** -filter -diff -merge
backend/tests/fixtures/*.py text diff merge
# Exclude experiment metrics CSV files from Git LFS so they are committed as native text assets
experiments/**/metrics.csv -filter -diff -merge

# Exclude frontend public web assets and backend static assets from Git LFS so CI/CD (Vercel, Docker) receives real files
frontend/public/** -filter -diff -merge
backend/app/static/** -filter -diff -merge

# Ensure canonical JSON benchmark raw artifacts retain exact POSIX LF line endings across all platforms
benchmarks/results/raw/*.json text eol=lf
