# ==============================================================================
# Cross-Bank Federated Fraud Intelligence Platform (CFI)
# Enterprise Production Environment Configuration Template
# Usage: Copy this file to .env and customize secrets before running docker compose.
# Command: cp .env.example .env (or run: python scripts/generate_secrets.py)
# ==============================================================================

# ── 1. Application & Service Environment ──────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false
SERVICE_NAME=monolith

# ── 2. Enterprise Gateway & Port Bindings ─────────────────────────────────────
# Change host ports here if standard ports (80, 443, 5432, 6379) are already in use
CFI_PORT_HTTP=80
CFI_PORT_HTTPS=443
CFI_PORT_PG=5432
CFI_PORT_REDIS=6379

# ── 3. PostgreSQL 16 Database Configuration ───────────────────────────────────
POSTGRES_USER=cfi_admin
POSTGRES_PASSWORD=cfi_secure_pass_2026_change_in_production
POSTGRES_DB=cfi_fraud_db
DATABASE_URL=postgresql+asyncpg://cfi_admin:cfi_secure_pass_2026_change_in_production@postgres:5432/cfi_fraud_db

# ── 4. Redis 7.2 Cache & Broker Configuration ─────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=cfi_redis_secure_pass_2026_change_in_production
REDIS_URL=redis://:cfi_redis_secure_pass_2026_change_in_production@redis:6379/0

# ── 5. Cryptography, JWT & Consortium Salts ───────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=cfi_super_secret_jwt_key_2026_enterprise_floor_must_be_64_chars_hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Type-Salted HMAC-SHA256 Consortium Salt for Zero-Raw-PII
CONSORTIUM_HMAC_SALT=cfi_consortium_global_pseudonymization_salt_2026

# Regulatory Envelope HMAC Secret for UNODC goAML & EU AMLA Export
CFI_REGULATORY_ENVELOPE_SECRET=cfi_regulatory_envelope_hmac_secret_2026_enterprise

# ── 6. Federated Learning & Dynamic Parameters ────────────────────────────────
FL_TOTAL_ROUNDS=10
FL_CLIENTS_PER_ROUND=3
FL_MIN_CLIENTS=2
FL_AGGREGATION_STRATEGY=krum
FL_LOCAL_EPOCHS=3
FL_LEARNING_RATE=0.01

# ── 7. Privacy Engine: Differential Privacy & Homomorphic Encryption ──────────
DP_ENABLED=true
DP_EPSILON=1.0
DP_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0
CKKS_POLY_MODULUS_DEGREE=8192

# ── 8. Hardware Security, HSM & Enclave Attestation ───────────────────────────
HARDWARE_ISOLATION_MODE=tee
SGX_QUOTE_VERIFICATION=simulated
HSM_PROVIDER=PKCS11
HSM_SLOT_ID=0
HSM_PIN=1234
HSM_LIB_PATH=/usr/lib/softhsm/libsofthsm2.so
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY_NAME=cfi-consortium-master-key

# ── 9. Observability & Monitoring (Optional Profile) ──────────────────────────
TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_in_production

# ── 10. Apache Kafka & CloudEvents 1.0 Event Streaming Bus ─────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=cfi-fraud-detection-group
KAFKA_TRANSACTION_TOPIC=org.cfi.finint.transactions.v1
KAFKA_ALERT_TOPIC=org.cfi.finint.alerts.v1
KAFKA_DLQ_TOPIC=org.cfi.finint.dlq.v1
KAFKA_RECALL_TOPIC=org.cfi.finint.recalls.v1
KAFKA_TICKET_TOPIC=org.cfi.finint.tickets.v1
KAFKA_ENABLED=true
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_MAX_POLL_RECORDS=500

